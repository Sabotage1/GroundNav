# Optional when the Android native wrapper is not served from the same Mac host.
# Example: VITE_GROUNDNAV_SERVER=http://192.168.1.20:4173
VITE_GROUNDNAV_SERVER=

# Testing credential requested for this prototype. Change before any shared deployment.
ADMIN_PASSWORD=1337

# Bind on all interfaces so an Android device on the same Wi-Fi can connect.
HOST=0.0.0.0
PORT=4173
